# Cloudflare Pages static-asset headers (not applied to Pages Function responses such as /tiles/*,
# which set their own headers). No CSP on purpose: the app needs WebGL, workers, blob:/data: images
# and cross-origin tile fetches from trek.nasa.gov.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN

# Vite content-hashed bundles
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Generated rasters, manifest, gazetteer and landing sites (stable names, rebuilt occasionally)
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
